# Soravelon runtime environment
SORAVELON_ENV=development
DJANGO_SETTINGS_MODULE=server.conf.settings

# Required in production. Development can keep using server/conf/secret_settings.py.
SECRET_KEY=replace-me

# Django / Evennia network surface
ALLOWED_HOSTS=localhost,127.0.0.1
SERVER_HOSTNAME=localhost
TELNET_PORT=4000
WEBSERVER_PORT=4001
SSH_PORT=4002
SSL_PORT=4003
WEBSOCKET_CLIENT_PORT=4005

# Database
DATABASE_ENGINE=sqlite3
DATABASE_NAME=server/evennia.db3
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=

# Logging / operations
DEBUG=false
LOG_DIR=server/logs
DEFAULT_ADMIN_EMAIL=admin@example.com
