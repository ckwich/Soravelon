# Soravelon runtime environment
SORAVELON_ENV=production
DJANGO_SETTINGS_MODULE=server.conf.settings

# Required in production. This placeholder is intentionally rejected at startup.
SECRET_KEY=replace-me-for-production

# HTTPS reverse proxy and Django host validation
ALLOWED_HOSTS=game.example.com
CSRF_TRUSTED_ORIGINS=https://game.example.com
SERVER_HOSTNAME=game.example.com
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true

# Evennia network surface. Plaintext telnet and optional SSH/SSL are off by default.
TELNET_ENABLED=false
TELNET_PORT=4000
WEBSERVER_PORT=4001
WEBSOCKET_CLIENT_PORT=4002
WEBSOCKET_CLIENT_URL=wss://ws.game.example.com
SSL_ENABLED=false
SSL_PORT=4003
SSH_ENABLED=false
SSH_PORT=4004
WEBSERVER_INTERNAL_PORT=4005

# PostgreSQL is required in production.
DATABASE_ENGINE=postgresql
DATABASE_NAME=soravelon
DATABASE_USER=soravelon
DATABASE_PASSWORD=replace-me
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

# Logging / operations
DEBUG=false
LOG_DIR=server/logs
DEFAULT_ADMIN_EMAIL=admin@example.com
